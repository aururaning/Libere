{
  "openapi": "3.1.0",
  "info": {
    "title": "Libere Agent API",
    "version": "1.1.0",
    "description": "Mac 本机接口。layout_blocks 的 dryRun=true 例外允许不带 requestID；不直接执行代码或抓取远程网址。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:19876"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v1/status": {
      "get": {
        "operationId": "status",
        "summary": "资料库身份与接口状态",
        "responses": {
          "200": {
            "description": "资料库身份与接口状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tools": {
      "get": {
        "operationId": "tools",
        "summary": "可调用工具及 JSON Schema",
        "responses": {
          "200": {
            "description": "可调用工具及 JSON Schema",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rules": {
      "get": {
        "operationId": "rules",
        "summary": "Agent 排版与归档规范",
        "responses": {
          "200": {
            "description": "Agent 排版与归档规范",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "openapi_json",
        "summary": "本 OpenAPI 文档",
        "responses": {
          "200": {
            "description": "本 OpenAPI 文档",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/call": {
      "post": {
        "operationId": "callTool",
        "summary": "调用工具；写入需要 workspaceID、requestID，修改已有页还需 expectedRevision。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "const": "list_pages"
                      },
                      "arguments": {
                        "type": "object",
                        "properties": {
                          "parentID": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "query": {
                            "type": "string"
                          },
                          "offset": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "limit": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100
                          }
                        },
                        "required": [],
                        "additionalProperties": false
                      },
                      "workspaceID": {
                        "type": "string"
                      },
                      "requestID": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "tool",
                      "arguments"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "const": "read_page"
                      },
                      "arguments": {
                        "type": "object",
                        "properties": {
                          "pageID": {
                            "type": "string",
                            "format": "uuid"
                          }
                        },
                        "required": [
                          "pageID"
                        ],
                        "additionalProperties": false
                      },
                      "workspaceID": {
                        "type": "string"
                      },
                      "requestID": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "tool",
                      "arguments"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "const": "read_attachment"
                      },
                      "arguments": {
                        "type": "object",
                        "properties": {
                          "pageID": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "blockID": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "format": {
                            "type": "string",
                            "enum": [
                              "metadata",
                              "text",
                              "base64"
                            ],
                            "default": "metadata"
                          },
                          "offset": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "limit": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100000
                          }
                        },
                        "required": [
                          "pageID",
                          "blockID"
                        ],
                        "additionalProperties": false
                      },
                      "workspaceID": {
                        "type": "string"
                      },
                      "requestID": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "tool",
                      "arguments"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "const": "create_page"
                      },
                      "arguments": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "parentID": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "isFolder": {
                            "type": "boolean"
                          },
                          "canvasWidth": {
                            "type": "number",
                            "minimum": 320,
                            "maximum": 6000
                          },
                          "style": {
                            "type": "string",
                            "enum": [
                              "reading",
                              "column",
                              "grid"
                            ],
                            "default": "reading",
                            "description": "reading：宽页正文+资料侧栏，窄页单列；column：顺序单列；grid：网格。"
                          },
                          "blocks": {
                            "type": "array",
                            "maxItems": 50,
                            "items": {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "enum": [
                                    "text",
                                    "formula",
                                    "file",
                                    "reference",
                                    "link"
                                  ]
                                },
                                "text": {
                                  "type": "string",
                                  "maxLength": 100000,
                                  "description": "文字为 Markdown；公式为 LaTeX。"
                                },
                                "filePath": {
                                  "type": "string",
                                  "description": "file 必填：当前资料库内已有文件的相对路径。只建立索引，不接收或复制文件字节。"
                                },
                                "url": {
                                  "type": "string",
                                  "format": "uri"
                                },
                                "sourceURL": {
                                  "type": "string",
                                  "format": "uri",
                                  "description": "原始资料的 http(s) 来源，仅记录，不自动访问。"
                                },
                                "sourcePageID": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "sourceBlockID": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "collapsed": {
                                  "type": "boolean",
                                  "default": true,
                                  "description": "附件默认收起为标题；false 展开预览。"
                                },
                                "height": {
                                  "type": "number",
                                  "minimum": 80,
                                  "maximum": 1600,
                                  "default": 480
                                }
                              },
                              "required": [
                                "kind"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "title"
                        ],
                        "additionalProperties": false
                      },
                      "workspaceID": {
                        "type": "string"
                      },
                      "requestID": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "tool",
                      "arguments",
                      "workspaceID",
                      "requestID"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "const": "append_blocks"
                      },
                      "arguments": {
                        "type": "object",
                        "properties": {
                          "pageID": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "expectedRevision": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "style": {
                            "type": "string",
                            "enum": [
                              "reading",
                              "column",
                              "grid"
                            ],
                            "default": "reading",
                            "description": "reading：宽页正文+资料侧栏，窄页单列；column：顺序单列；grid：网格。"
                          },
                          "blocks": {
                            "type": "array",
                            "maxItems": 50,
                            "items": {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "enum": [
                                    "text",
                                    "formula",
                                    "file",
                                    "reference",
                                    "link"
                                  ]
                                },
                                "text": {
                                  "type": "string",
                                  "maxLength": 100000,
                                  "description": "文字为 Markdown；公式为 LaTeX。"
                                },
                                "filePath": {
                                  "type": "string",
                                  "description": "file 必填：当前资料库内已有文件的相对路径。只建立索引，不接收或复制文件字节。"
                                },
                                "url": {
                                  "type": "string",
                                  "format": "uri"
                                },
                                "sourceURL": {
                                  "type": "string",
                                  "format": "uri",
                                  "description": "原始资料的 http(s) 来源，仅记录，不自动访问。"
                                },
                                "sourcePageID": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "sourceBlockID": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "collapsed": {
                                  "type": "boolean",
                                  "default": true,
                                  "description": "附件默认收起为标题；false 展开预览。"
                                },
                                "height": {
                                  "type": "number",
                                  "minimum": 80,
                                  "maximum": 1600,
                                  "default": 480
                                }
                              },
                              "required": [
                                "kind"
                              ],
                              "additionalProperties": false
                            },
                            "minItems": 1
                          }
                        },
                        "required": [
                          "pageID",
                          "expectedRevision",
                          "blocks"
                        ],
                        "additionalProperties": false
                      },
                      "workspaceID": {
                        "type": "string"
                      },
                      "requestID": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "tool",
                      "arguments",
                      "workspaceID",
                      "requestID"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "const": "update_block"
                      },
                      "arguments": {
                        "type": "object",
                        "properties": {
                          "pageID": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "expectedRevision": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "blockID": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "text": {
                            "type": "string",
                            "maxLength": 100000
                          },
                          "collapsed": {
                            "type": "boolean"
                          },
                          "sourceURL": {
                            "type": "string",
                            "format": "uri",
                            "description": "原始资料的 http(s) 来源，仅记录，不自动访问。"
                          }
                        },
                        "required": [
                          "pageID",
                          "blockID",
                          "expectedRevision"
                        ],
                        "additionalProperties": false
                      },
                      "workspaceID": {
                        "type": "string"
                      },
                      "requestID": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "tool",
                      "arguments",
                      "workspaceID",
                      "requestID"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "const": "layout_blocks"
                      },
                      "arguments": {
                        "type": "object",
                        "properties": {
                          "pageID": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "expectedRevision": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "blockIDs": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 50,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "format": "uuid"
                            }
                          },
                          "style": {
                            "type": "string",
                            "enum": [
                              "reading",
                              "column",
                              "grid"
                            ],
                            "default": "reading",
                            "description": "reading：宽页正文+资料侧栏，窄页单列；column：顺序单列；grid：网格。"
                          },
                          "dryRun": {
                            "type": "boolean",
                            "default": true
                          }
                        },
                        "required": [
                          "pageID",
                          "expectedRevision"
                        ],
                        "additionalProperties": false
                      },
                      "workspaceID": {
                        "type": "string"
                      },
                      "requestID": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "tool",
                      "arguments",
                      "workspaceID",
                      "requestID"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功；写入返回 page 摘要和 changedBlocks，完整正文用 read_page"
          },
          "400": {
            "description": "请求/参数无效"
          },
          "401": {
            "description": "令牌无效"
          },
          "403": {
            "description": "只读或来源不允许"
          },
          "404": {
            "description": "页面/块不存在"
          },
          "409": {
            "description": "版本冲突、重复请求 ID 内容不一致、工作区变化或布局受保护"
          },
          "413": {
            "description": "超出大小上限"
          },
          "422": {
            "description": "内容或排版无效"
          },
          "500": {
            "description": "存储错误"
          },
          "503": {
            "description": "接口暂不可用"
          }
        }
      }
    }
  }
}
